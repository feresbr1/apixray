l\",\"matchLevel\":\"full\",\"fullyHighlighted\":false,\"matchedWords\":[\"webassembly\"]},\"author\":{\"value\":\"Ajedi32\",\"matchLevel\":\"none\",\"matchedWords\":[]}},\"_rankingInfo\":{\"nbTypos\":0,\"firstMatchedWord\":0,\"proximityDistance\":0,\"userScore\":88,\"geoDistance\":0,\"geoPrecision\":1,\"nbExactWords\":0,\"words\":1,\"filters\":1}},{\"title\":\"Sqlite3 WebAssembly\",\"url\":\"https://sqlite.org/wasm/doc/trunk/index.md\",\"author\":\"whatever3\",\"points\":647,\"num_comments\":192,\"story_id\":41851051,\"created_at_i\":1729014327,\"created_at\":\"2024-10-15T17:45:27Z\",\"updated_at\":\"2026-09-08T20:17:48Z\",\"_tags\":[\"story\",\"author_whatever3\",\"story_41851051\"],\"children\":[41851202,41851263,41851270,41851272,41851345,41851739,41851815,41851864,41851916,41851934,41852016,41852085,41852119,41852302,41852607,41853741,41854170,41854281,41854598,41856590,41857082,41858455,41858874,41859753,41860968,41866967,41870269],\"objectID\":\"41851051\",\"_highlightResult\":{\"title\":{\"value\":\"Sqlite3 <em>WebAssembly</em>\",\"matchLevel\":\"full\",\"fullyHighlighted\":false,\"matchedWords\":[\"webassembly\"]},\"url\":{\"value\":\"https://sqlite.org/wasm/doc/trunk/index.md\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"author\":{\"value\":\"whatever3\",\"matchLevel\":\"none\",\"matchedWords\":[]}},\"_rankingInfo\":{\"nbTypos\":0,\"firstMatchedWord\":0,\"proximityDistance\":0,\"userScore\":87,\"geoDistance\":0,\"geoPrecision\":1,\"nbExactWords\":0,\"words\":1,\"filters\":1}},{\"title\":\"WebAssembly: Mozilla Won\",\"url\":\"http://robert.ocallahan.org/2017/06/webassembly-mozilla-won.html\",\"author\":\"nachtigall\",\"points\":626,\"num_comments\":361,\"story_id\":14458648,\"created_at_i\":1496303885,\"created_at\":\"2017-06-01T07:58:05Z\",\"updated_at\":\"2024-10-17T19:41:28Z\",\"_tags\":[\"story\",\"author_nachtigall\",\"story_14458648\"],\"children\":[14458732,14458803,14458873,14459106,14459190,14459206,14459240,14459253,14459254,14459571,14459574,14459629,14459649,14459680,14459723,14459784,14459786,14459923,14460144,14460698,14461219,14461697,14461913,14461993,14462075,14462711,14465708],\"objectID\":\"14458648\",\"_highlightResult\":{\"title\":{\"value\":\"<em>WebAssembly</em>: Mozilla Won\",\"matchLevel\":\"full\",\"fullyHighlighted\":false,\"matchedWords\":[\"webassembly\"]},\"url\":{\"value\":\"http://robert.ocallahan.org/2017/06/<em>webassembly</em>-mozilla-won.html\",\"matchLevel\":\"full\",\"fullyHighlighted\":false,\"matchedWords\":[\"webassembly\"]},\"author\":{\"value\":\"nachtigall\",\"matchLevel\":\"none\",\"matchedWords\":[]}},\"_rankingInfo\":{\"nbTypos\":0,\"firstMatchedWord\":0,\"proximityDistance\":0,\"userScore\":86,\"geoDistance\":0,\"geoPrecision\":1,\"nbExactWords\":0,\"words\":1,\"filters\":1}},{\"title\":\"Tell HN: We are trying to get tail calls into the WebAssembly standard\",\"author\":\"apignotti\",\"points\":625,\"story_text\":\"WebAssembly is a modern bytecode supported by all browsers and designed to be a compiler target for a wide variety of programming languages.<p>To effectively support some forms of Functional Programming support for tail-calls has been proposed as an extension to the WebAssembly standard.<p>This proposal has reached Phase3 of the standardization process years ago, but has since stalled.<p>Phase3 is known as &quot;the implementation phase&quot; and the prerequisite for advancing the proposal to Phase4 is to have support in two different browser engines. V8&#x2F;Chrome support has been available for a long time, so another engine is required.<p>To unblock this situation we have contributed full support for WebAssembly Tail Calls to JavaScript&#x2F;WebKit&#x2F;Safari. The PR is available here:<p><a href=\\\"https:&#x2F;&#x2F;github.com&#x2F;WebKit&#x2F;WebKit&#x2F;pull&#x2F;2065\\\" rel=\\\"nofollow\\\">https:&#x2F;&#x2F;github.com&#x2F;WebKit&#x2F;WebKit&#x2F;pull&#x2F;2065</a><p>An in-depth article about the challenges of implementing this feature is also available. This is intended both as documentation for our contribution, but also as a general explainer about how tails calls actually work, with a particular focus on stack space management.<p><a href=\\\"https:&#x2F;&#x2F;leaningtech.com&#x2F;fantastic-tail-calls-and-how-to-implement-them&#x2F;\\\" rel=\\\"nofollow\\\">https:&#x2F;&#x2F;leaningtech.com&#x2F;fantastic-tail-calls-and-how-to-impl...</a>\",\"num_comments\":290,\"story_id\":32069418,\"created_at_i\":1657631663,\"created_at\":\"2022-07-12T13:14:23Z\",\"updated_at\":\"2025-01-29T16:53:08Z\",\"_tags\":[\"story\",\"author_apignotti\",\"story_32069418\",\"ask_hn\"],\"children\":[32070074,32070105,32070488,32070652,32070685,32070712,32071106,32071308,32071423,32071515,32071531,32071795,32072050,32072072,32072711,32073680,32073868,32074003,32074017,32074725,32075827,32078190,32080547,32080781,32081586,32091125],\"objectID\":\"32069418\",\"_highlightResult\":{\"title\":{\"value\":\"Tell HN: We are trying to get tail calls into the <em>WebAssembly</em> standard\",\"matchLevel\":\"full\",\"fullyHighlighted\":false,\"matchedWords\":[\"webassembly\"]},\"author\":{\"value\":\"apignotti\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"story_text\":{\"value\":\"<em>WebAssembly</em> is a modern bytecode supported by all browsers and designed to be a compiler target for a wide variety of programming languages.<p>To effectively support some forms of Functional Programming support for tail-calls has been proposed as an extension to the <em>WebAssembly</em> standard.<p>This proposal has reached Phase3 of the standardization process years ago, but has since stalled.<p>Phase3 is known as &quot;the implementation phase&quot; and the prerequisite for advancing the proposal to Phase4 is to have support in two different browser engines. V8/Chrome support has been available for a long time, so another engine is required.<p>To unblock this situation we have contributed full support for <em>WebAssembly</em> Tail Calls to JavaScript/WebKit/Safari. The PR is available here:<p><a href=\\\"https://github.com/WebKit/WebKit/pull/2065\\\" rel=\\\"nofollow\\\">https://github.com/WebKit/WebKit/pull/2065</a><p>An in-depth article about the challenges of implementing this feature is also available. This is intended both as documentation for our contribution, but also as a general explainer about how tails calls actually work, with a particular focus on stack space management.<p><a href=\\\"https://leaningtech.com/fantastic-tail-calls-and-how-to-implement-them/\\\" rel=\\\"nofollow\\\">https://leaningtech.com/fantastic-tail-calls-and-how-to-impl...</a>\",\"matchLevel\":\"full\",\"fullyHighlighted\":false,\"matchedWords\":[\"webassembly\"]}},\"_rankingInfo\":{\"nbTypos\":0,\"firstMatchedWord\":0,\"proximityDistance\":0,\"userScore\":85,\"geoDistance\":0,\"geoPrecision\":1,\"nbExactWords\":0,\"words\":1,\"filters\":1}},{\"title\":\"WebAssembly support now shipping in all major browsers\",\"url\":\"https://blog.mozilla.org/blog/2017/11/13/webassembly-in-browsers/\",\"author\":\"subir\",\"points\":574,\"num_comments\":339,\"story_id\":15694018,\"created_at_i\":1510656487,\"created_at\":\"2017-11-14T10:48:07Z\",\"updated_at\":\"2025-06-24T14:01:53Z\",\"_tags\":[\"story\",\"author_subir\",\"story_15694018\"],\"children\":[15694127,15694165,15694186,15694187,15694202,15694220,15694331,15694344,15694356,15694375,15694467,15694509,15694516,15694524,15694560,15694696,15694982,15695150,15695163,15695275,15695392,15695939,15696060,15696431,15696782,15696938,15697612,15699431,15700507],\"objectID\":\"15694018\",\"_highlightResult\":{\"title\":{\"value\":\"<em>WebAssembly</em> support now shipping in all major browsers\",\"matchLevel\":\"full\",\"fullyHighlighted\":false,\"matchedWords\":[\"webassembly\"]},\"url\":{\"value\":\"https://blog.mozilla.org/blog/2017/11/13/<em>webassembly</em>-in-browsers/\",\"matchLevel\":\"full\",\"fullyHighlighted\":false,\"matchedWords\":[\"webassembly\"]},\"author\":{\"value\":\"subir\",\"matchLevel\":\"none\",\"matchedWords\":[]}},\"_rankingInfo\":{\"nbTypos\":0,\"firstMatchedWord\":0,\"proximityDistance\":0,\"userScore\":84,\"geoDistance\":0,\"geoPrecision\":1,\"nbExactWords\":0,\"words\":1,\"filters\":1}},{\"title\":\"WebAssembly 101: A developer’s first steps\",\"url\":\"http://blog.openbloc.fr/webassembly-first-steps/\",\"author\":\"blaze33\",\"points\":573,\"num_comments\":150,\"story_id\":14495893,\"created_at_i\":1496741398,\"created_at\":\"2017-06-06T09:29:58Z\",\"updated_at\":\"2026-07-30T23:38:05Z\",\"_tags\":[\"story\",\"author_blaze33\",\"story_14495893\"],\"children\":[14496254,14496317,14496380,14496448,14496500,14496525,14496546,14496579,14496695,14496735,14496822,14497018,14497330,14497641,14498487,14498543,14498779,14499492,14500458,14501186,14501319,14502593,14510726,14520029],\"objectID\":\"14495893\",\"_highlightResult\":{\"title\":{\"value\":\"<em>WebAssembly</em> 101: A developer’s first steps\",\"matchLevel\":\"full\",\"fullyHighlighted\":false,\"matchedWords\":[\"webassembly\"]},\"url\":{\"value\":\"http://blog.openbloc.fr/<em>webassembly</em>-first-steps/\",\"matchLevel\":\"full\",\"fullyHighlighted\":false,\"matchedWords\":[\"webassembly\"]},\"author\":{\"value\":\"blaze33\",\"matchLevel\":\"none\",\"matchedWords\":[]}},\"_rankingInfo\":{\"nbTypos\":0,\"firstMatchedWord\":0,\"proximityDistance\":0,\"userScore\":83,\"geoDistance\":0,\"geoPrecision\":1,\"nbExactWords\":0,\"words\":1,\"filters\":1}},{\"title\":\"LibreOffice running natively in the browser via WebAssembly\",\"url\":\"https://lab.allotropia.de/wasm/\",\"author\":\"syrusakbary\",\"points\":571,\"num_comments\":208,\"story_id\":30356020,\"created_at_i\":1644981947,\"created_at\":\"2022-02-16T03:25:47Z\",\"updated_at\":\"2026-02-06T02:44:19Z\",\"_tags\":[\"story\",\"author_syrusakbary\",\"story_30356020\"],\"children\":[30356032,30356146,30356174,30356207,30356208,30356211,30356358,30356435,30356548,30356588,30356837,30356862,30357078,30357097,30357215,30357220,